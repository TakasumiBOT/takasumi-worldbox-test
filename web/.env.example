# Vercel の Project Settings > Environment Variables に設定する（値は本家 Pi と同じものを使う）
# Bot 本体の API（経済・bot_kv の正）。未設定だとオンライン機能が全部止まる
BOT_API_BASE_URL=
BOT_API_KEY=
# Discord ログイン / セッション / Activity 認証
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_SESSION_SECRET=
# この Vercel デプロイの公開 URL で /api/auth/discord/callback を指定し、
# Discord Developer Portal 側の Redirects にも同じ URL を登録すること
DISCORD_REDIRECT_URI=
# 任意: WORLD BOX の管理者 Discord ID（カンマ区切り）
WORLDBOX_ADMIN_IDS=
