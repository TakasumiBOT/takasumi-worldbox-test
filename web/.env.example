# Vercel の Project Settings > Environment Variables に設定する。
# このリポジトリは AGO 本家とは完全に独立した環境で、本家の値は使わない。

# --- データベース（Neon Postgres） ---
# スキーマは web/db/schema.sql。適用は `npm run setup:db`（DATABASE_URL 使用）。
DATABASE_URL=

# --- bot-api 互換レイヤ（自前） ---
# このアプリ自身が /botapi/v1/query と /botapi/v1/rpc を実装している
# （web/app/botapi/）。BASE_URL は自ドメインの /botapi を指すこと。
BOT_API_BASE_URL=https://<your-domain>/botapi
# 自前で生成したランダムな秘密。サーバー側の照合にも同じ値を使う。
BOT_API_KEY=

# --- Discord ログイン / セッション / Activity 認証 ---
# 専用の Discord OAuth アプリを用意し、その値を設定する（本家と共有しない）。
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_SESSION_SECRET=
# このデプロイの公開 URL で /api/auth/discord/callback を指定し、
# Discord Developer Portal 側の Redirects にも同じ URL を登録すること。
DISCORD_REDIRECT_URI=

# --- Vercel Cron（経済オプのスイープ） ---
# 設定すると Vercel が /api/worldbox/internal/economy-sweep へ
# Authorization: Bearer <CRON_SECRET> を自動で付けて毎分呼ぶ。
CRON_SECRET=

# --- サイトの公開 URL ---
# 未設定の場合はリクエストのオリジンを使う。agobot.app は使わない。
NEXT_PUBLIC_SITE_URL=

# 任意: WORLD BOX の管理者 Discord ID（カンマ区切り）。未設定だと管理者はいない。
WORLDBOX_ADMIN_IDS=
