# 環境変数は「必須は DATABASE_URL だけ」。残りは全て任意で、未設定でも
# リポジトリ内蔵の設定とプロセス内経路で本番が成立する（詳細は各節）。
# Vercel の Project Settings > Environment Variables に設定できる場合は
# そちらが常に優先される。
# このリポジトリは AGO 本家とは完全に独立した環境で、本家の値は使わない。

# --- データベース（Neon Postgres） ---
# スキーマは db/schema.sql。適用は `npm run setup:db`（DATABASE_URL 使用）。
DATABASE_URL=

# --- bot-api 互換レイヤ（自前） ---
# アプリ内部の呼び出しは lib/bot-api.ts がプロセス内で直接ハンドラを
# 呼ぶため、通常は設定不要。外部の bot-api（または自ドメインの /botapi
# ルート）へ HTTP で接続したい場合だけ設定する。
# BOT_API_BASE_URL=https://<your-domain>/botapi
# BOT_API_KEY=
# 公開ルート /botapi/v1/* の Bearer 照合は BOT_API_KEY で行い、
# 未設定なら公開リクエストは常に 401（fail-closed）。

# --- Discord ログイン / セッション / Activity 認証 ---
# 未設定の場合は lib/deploy-config.ts の値を使う（env が優先）。
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_SESSION_SECRET=
# DISCORD_REDIRECT_URI=

# --- Vercel Cron ---
# 定期処理（経済スイープ・会社の時給/法人税・株式の配当）の主経路は
# 遅延実行（通常トラフィックに相乗り、lib/worldbox/core/lazy-jobs.ts）
# で、CRON_SECRET が無くても進む。Cron を併用したい場合だけ設定する:
# 設定すると Vercel が各内部ルートへ Authorization: Bearer <CRON_SECRET>
# を自動で付けて呼ぶ。未設定なら Cron ルートは fail closed（401）。
# CRON_SECRET=

# --- サイトの公開 URL ---
# 未設定の場合はリクエストのオリジンを使う。agobot.app は使わない。
NEXT_PUBLIC_SITE_URL=

# 任意: WORLD BOX の管理者 Discord ID（カンマ区切り）。未設定だと管理者はいない。
WORLDBOX_ADMIN_IDS=
